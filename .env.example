# העתיקו ל־.env.local ומלאו ערכים. לעולם לא לעשות commit לקובץ עם ערכים אמיתיים.
# בפרודקשן: הערכים נשמרים רק ב־Vercel → Settings → Environment Variables.

# Supabase (פרויקט נפרד לחנות)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# בלי SUPABASE_SERVICE_ROLE_KEY: מצב פיתוח, תמונות הלקוחות נשארות בדפדפן ולא עולות לשרת

# ניקוי יומי של תמונות זמניות (Vercel Cron שולח אותו אוטומטית). מחרוזת אקראית ארוכה
CRON_SECRET=
# רשות: מפתח ל־hash של כתובות IP בהגבלת קצב ההעלאה (ברירת מחדל: נגזר מ־service role)
UPLOAD_HASH_SECRET=
# רשות: תקרת העלאות ליממה בכל האתר (ברירת מחדל 2000)
UPLOADS_PER_DAY=

# סליקה: mock (פיתוח, ללא חשבון) | grow-sandbox | grow-live (רק באישור)
PAYMENT_PROVIDER=mock
GROW_API_KEY=
GROW_PAGE_CODE=
GROW_USER_ID=
GROW_WEBHOOK_SECRET=

# קבלות: mock | morning
RECEIPT_PROVIDER=mock
MORNING_API_KEY_ID=
MORNING_API_SECRET=

# Make (מסלול "שלחו אליי מייל")
MAKE_WEBHOOK_URL=
MAKE_INBOUND_SECRET=

# כתובת האתר (לקישורי חזרה מהסליקה ולקישורי העלאה)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
